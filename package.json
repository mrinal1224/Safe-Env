{
  "name": "@mrinal/safe-env",
  "version": "0.1.0",
  "description": "Type-safe environment variable validation for Node.js and TypeScript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "env",
    "environment-variables",
    "environment",
    "typescript",
    "validation",
    "configuration",
    "nodejs",
    "config"
  ],
  "author": "Mrinal Bhattacharya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrinal1224/Safe-Env.git"
  },
  "homepage": "https://github.com/mrinal1224/Safe-Env#readme",
  "bugs": {
    "url": "https://github.com/mrinal1224/Safe-Env/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0"
  }
}
